// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingSaleType {
  FIXED
  AUCTION
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

enum WeaponInstanceStatus {
  OWNED
  LISTED
}

enum ArmorInstanceStatus {
  OWNED
  LISTED
}

enum TradeStatus {
  PENDING
  LOCKED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum TradeOfferItemKind {
  STACK
  WEAPON_INSTANCE
  ARMOR_INSTANCE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MinionTraitType {
  MINER
  LUMBER
  FARMER
  FISHER
  FIGHTER
}

enum MinionJobType {
  UNASSIGNED
  ADVENTURER
  MINER
  FISHER
  ARCHAEOLOGIST
  EXPLORER
  LUMBERJACK
  HERBALIST
  BLACKSMITH
  JEWELER
  ALCHEMIST
  COOK
  SCRAPPER
  WARRIOR
  ARCHER
  MAGE
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  /** 최초 로그인 시 닉네임을 사용자가 확정했는지 */
  usernameChosen Boolean @default(true)
  /** Google OAuth `sub` */
  googleId  String?  @unique
  email     String?  @unique
  createdAt DateTime @default(now())

  /** 황실 거래로 쌓이는 명예 점수 */
  honorPoints  Int @default(0)
  /** 지하도시(암시장) 거래로 쌓이는 악명 점수 */
  infamyPoints Int @default(0)
  /** 명예로 하사되는 칭호(표시용) */
  honorTitle   String?

  /** 0..N-1 = 진행 중 단계, 100 = 튜토리얼 완료 (`shared/tutorial`) */
  tutorialStep Int @default(0)
  /** 홈 대시보드에 표시할 대표 미니언 (PVP·결투 대표와 동일) */
  representativeMinionId String?
  representativeMinion   Minion? @relation("UserRepresentativeMinion", fields: [representativeMinionId], references: [id], onDelete: SetNull)

  /** 무탑 주간 연금 — ISO 주차 키(월요일 기준) */
  towerPensionWeekKey String @default("")
  /** 해당 주에 기록한 최고 층(연금 산정) */
  towerPensionFloor Int @default(0)
  /** 마지막 일일 연금 수령 일자 YYYY-MM-DD (UTC) */
  towerLastPensionClaimDay String @default("")

  /** 자동 탐험 일일 웨이브 집계 (UTC 일자 키와 쌍) */
  autoExploreDailyWaves Int @default(0)
  autoExploreDayKey     String @default("")

  wallet    Wallet?
  botBudget BotBudget?
  minions   MinionInventory?
  minionEntities Minion[]
  itemEnhancements UserItemEnhancement[]
  weaponInstances WeaponInstance[]
  armorInstances ArmorInstance[]
  dungeonRuns DungeonRun[]
  dungeonGoldEarns DungeonGoldEarn[]
  raidRuns RaidRun[]
  towerRuns TowerRun[]
  leaderboardEntries LeaderboardEntry[]
  stacks    InventoryStack[]
  listings  Listing[] @relation("SellerListings")
  highestOn Listing[] @relation("HighestBidder")
  bids      Bid[]

  tradeSessionsA TradeSession[] @relation("TradeUserA")
  tradeSessionsB TradeSession[] @relation("TradeUserB")
  tradeEscrowStacks TradeEscrowStack[]

  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  pvpAttacks  PvpMatch[] @relation("PvpAttacker")
  pvpDefenses PvpMatch[] @relation("PvpDefender")

  chatMessages         ChatMessage[]

  weaponCodexEntries WeaponCodexEntry[]
  armorCodexEntries ArmorCodexEntry[]

  royalTrades      RoyalTradeLog[]
  blackMarketTrades BlackMarketTradeLog[]
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model TradeSession {
  id String @id @default(cuid())

  userAId String
  userBId String
  userA User @relation("TradeUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("TradeUserB", fields: [userBId], references: [id], onDelete: Cascade)

  status TradeStatus @default(PENDING)

  offeredGoldA Int @default(0)
  offeredGoldB Int @default(0)
  lockedGoldA  Int @default(0)
  lockedGoldB  Int @default(0)

  lockedA Boolean @default(false)
  lockedB Boolean @default(false)
  confirmedAAt DateTime?
  confirmedBAt DateTime?

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items TradeOfferItem[]
  escrowStacks TradeEscrowStack[]

  @@index([userAId, status, createdAt])
  @@index([userBId, status, createdAt])
  @@index([status, expiresAt])
}

model TradeOfferItem {
  id String @id @default(cuid())
  tradeId String
  trade TradeSession @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  /** "A" | "B" */
  side String
  kind TradeOfferItemKind

  // STACK
  itemId String?
  quantity Int @default(0)

  // INSTANCE
  weaponInstanceId String? @unique
  armorInstanceId  String? @unique

  createdAt DateTime @default(now())

  @@index([tradeId, side])
  @@index([tradeId, kind])
}

model TradeEscrowStack {
  id String @id @default(cuid())
  tradeId String
  trade TradeSession @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity Int @default(0)

  createdAt DateTime @default(now())

  @@index([tradeId])
  @@index([userId, createdAt])
  @@unique([tradeId, userId, itemId])
}

model RoyalPrice {
  itemId String @id
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /** 황실이 유저에게 파는 가격(매도) - 1개당 */
  buyPricePerUnit  Int
  /** 황실이 유저에게서 사는 가격(매입) - 1개당 */
  sellPricePerUnit Int

  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
}

enum BlackMarketEventKind {
  BOOM
  CRASH
}

model BlackMarketPrice {
  itemId String @id
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /** 기준가 대비 배수 (예: 1.25). */
  multiplier Float @default(1)
  updatedAt DateTime @updatedAt
}

model BlackMarketEvent {
  id String @id @default(cuid())
  kind BlackMarketEventKind
  /** 이벤트가 적용되는 아이템 카테고리(예: \"재료\"). null이면 전체 */
  category String?
  /** 특정 아이템만 타겟팅할 때 사용. null이면 category 기준 */
  itemId String?
  item   Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /** 이벤트 추가 배수 (예: 1.5). */
  multiplier Float
  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())

  trades BlackMarketTradeLog[]

  @@index([startsAt])
  @@index([endsAt])
  @@index([category, startsAt])
  @@index([itemId, startsAt])
}

model RoyalTradeLog {
  id String @id @default(cuid())
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /** BUY=황실에서 구매, SELL=황실에 판매 */
  side String
  quantity Int
  /** 거래로 인한 골드 변화량. 유저 관점(+면 획득, -면 지불) */
  goldDelta Int
  honorDelta Int

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([itemId, createdAt])
}

model BlackMarketTradeLog {
  id String @id @default(cuid())
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  side String
  quantity Int
  goldDelta Int
  infamyDelta Int
  eventId String?
  event   BlackMarketEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([itemId, createdAt])
  @@index([eventId, createdAt])
}

// NPC market makers: daily buy budget (KST) separate from wallet gold.
model BotBudget {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // YYYYMMDD in Asia/Seoul
  dayKey String

  remainingBuyBudget Int @default(5000)

  updatedAt DateTime @updatedAt
}

model Wallet {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goldAvailable Int      @default(0)
  goldLocked    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model UserItemEnhancement {
  userId String
  itemId String
  level  Int @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model MinionInventory {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  owned        Int      @default(0)
  dungeonOwned Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Minion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  representativeForUsers User[] @relation("UserRepresentativeMinion")

  level Int @default(1)
  /** 현재 레벨에서 다음 레벨까지 누적 경험치 */
  experience Int @default(0)
  /** 레벨업으로 받은 미배분 스탯 포인트 */
  unspentStatPoints Int @default(0)
  /** 레벨업·전직으로 받은 미배분 스킬 포인트 */
  unspentSkillPoints Int @default(0)
  /** 스킬 id → 레벨 JSON (예: {"sword_slash":3}) */
  skillLevelsJson String @default("{}")
  jobType MinionJobType @default(ADVENTURER)

  /** 기본 스탯 — 0에서 시작, 레벨업 배분으로만 성장 */
  strength     Int @default(0)
  agility      Int @default(0)
  intelligence Int @default(0)
  endurance    Int @default(0)

  /** 전직 단계 — 0=모험가, 1=1차(검사), 2=2차(특화) */
  promotionTier Int @default(0)
  /** 전직 후 저장 클래스 (SWORDSMAN, WARRIOR 등) */
  promotionClass String @default("ADVENTURER")

  /** 사용자 지정 이름 — 없으면 직업명 표시 */
  nickname String?

  // 개별 무기 장착(던전 전투에 사용)
  equippedWeaponInstanceId String?
  equippedWeaponInstance   WeaponInstance? @relation(fields: [equippedWeaponInstanceId], references: [id], onDelete: SetNull)

  /** 방어구(스택 아이템 id) — 레거시; 신규는 instanceId 사용 */
  equippedHelmetItemId String?
  equippedHelmet       Item? @relation("MinionEquippedHelmet", fields: [equippedHelmetItemId], references: [id], onDelete: SetNull)
  equippedChestItemId  String?
  equippedChest        Item? @relation("MinionEquippedChest", fields: [equippedChestItemId], references: [id], onDelete: SetNull)
  equippedPantsItemId  String?
  equippedPants        Item? @relation("MinionEquippedPants", fields: [equippedPantsItemId], references: [id], onDelete: SetNull)
  equippedBootsItemId  String?
  equippedBoots        Item? @relation("MinionEquippedBoots", fields: [equippedBootsItemId], references: [id], onDelete: SetNull)

  equippedHelmetInstanceId String?
  equippedHelmetInstance   ArmorInstance? @relation("MinionEquippedHelmetInst", fields: [equippedHelmetInstanceId], references: [id], onDelete: SetNull)
  equippedChestInstanceId  String?
  equippedChestInstance    ArmorInstance? @relation("MinionEquippedChestInst", fields: [equippedChestInstanceId], references: [id], onDelete: SetNull)
  equippedPantsInstanceId  String?
  equippedPantsInstance    ArmorInstance? @relation("MinionEquippedPantsInst", fields: [equippedPantsInstanceId], references: [id], onDelete: SetNull)
  equippedBootsInstanceId  String?
  equippedBootsInstance    ArmorInstance? @relation("MinionEquippedBootsInst", fields: [equippedBootsInstanceId], references: [id], onDelete: SetNull)

  equippedRing1ItemId     String?
  equippedRing1           Item? @relation("MinionEquippedRing1", fields: [equippedRing1ItemId], references: [id], onDelete: SetNull)
  equippedRing2ItemId     String?
  equippedRing2           Item? @relation("MinionEquippedRing2", fields: [equippedRing2ItemId], references: [id], onDelete: SetNull)
  equippedNecklaceItemId  String?
  equippedNecklace        Item? @relation("MinionEquippedNecklace", fields: [equippedNecklaceItemId], references: [id], onDelete: SetNull)
  equippedNecklace2ItemId String?
  equippedNecklace2       Item? @relation("MinionEquippedNecklace2", fields: [equippedNecklace2ItemId], references: [id], onDelete: SetNull)
  equippedRelicItemId     String?
  equippedRelic           Item? @relation("MinionEquippedRelic", fields: [equippedRelicItemId], references: [id], onDelete: SetNull)
  equippedRelic2ItemId    String?
  equippedRelic2          Item? @relation("MinionEquippedRelic2", fields: [equippedRelic2ItemId], references: [id], onDelete: SetNull)
  equippedRelic3ItemId    String?
  equippedRelic3          Item? @relation("MinionEquippedRelic3", fields: [equippedRelic3ItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dungeonPartyMemberships DungeonPartyMember[]
  raidPartyMemberships RaidPartyMember[]
  towerPartyMemberships TowerPartyMember[]
  traits MinionTrait[]

  @@index([userId])
  @@index([equippedWeaponInstanceId])
  @@index([equippedHelmetItemId])
  @@index([equippedChestItemId])
  @@index([equippedPantsItemId])
  @@index([equippedBootsItemId])
  @@index([equippedHelmetInstanceId])
  @@index([equippedChestInstanceId])
  @@index([equippedPantsInstanceId])
  @@index([equippedBootsInstanceId])
  @@index([equippedRing1ItemId])
  @@index([equippedRing2ItemId])
  @@index([equippedNecklaceItemId])
  @@index([equippedNecklace2ItemId])
  @@index([equippedRelicItemId])
  @@index([equippedRelic2ItemId])
  @@index([equippedRelic3ItemId])
}

model WeaponInstance {
  id         String @id @default(cuid())
  userId     String
  baseItemId String
  enhanceLevel Int @default(0)
  /** 장비 품질 0~10 (품질 연마제 최대 10회) */
  quality Int @default(0)
  qualityCraftCount Int @default(0)
  /** 착용·스탯 기준 아이템 레벨 (10~140, 5 단위) */
  itemLevel Int @default(10)
  status WeaponInstanceStatus @default(OWNED)
  /** 사용자가 실수 방지용으로 잠근 장비 */
  userLocked Boolean @default(false)
  /** JSON 배열: `{ kind, tier }[]` 제작 시 부여 옵션 (`itemOptions.ts`) */
  optionsJson String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseItem Item @relation(fields: [baseItemId], references: [id], onDelete: Restrict)
  equippedOn Minion[]
  listing Listing?

  @@index([userId, createdAt])
  @@index([baseItemId])
}

/** 무기 도감 — 종류·마일스톤별 등록, 계정 공통 버프 누적 */
model WeaponCodexEntry {
  id        String   @id @default(cuid())
  userId    String
  baseItemId String
  milestoneId String @default("base")
  /** 등록 무기 전투력의 10% (정수) */
  bonusPower Int @default(0)
  /** ATK×1000 기준 10% (표시·전투 보정) */
  bonusAtkMilli Int @default(0)
  /** MAG×1000 기준 10% */
  bonusMagicMilli Int @default(0)
  registeredEnhanceLevel Int @default(0)
  registeredQuality Int @default(0)
  registeredItemLevel Int @default(10)
  registeredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, baseItemId, milestoneId])
  @@index([userId])
}

/** 방어구 도감 — 종류·마일스톤별 등록, 계정 공통 버프 누적 */
model ArmorCodexEntry {
  id        String   @id @default(cuid())
  userId    String
  baseItemId String
  milestoneId String @default("base")
  bonusPower Int @default(0)
  bonusHpMilli Int @default(0)
  bonusDefMilli Int @default(0)
  registeredEnhanceLevel Int @default(0)
  registeredQuality Int @default(0)
  registeredItemLevel Int @default(10)
  registeredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, baseItemId, milestoneId])
  @@index([userId])
}

model ArmorInstance {
  id         String @id @default(cuid())
  userId     String
  baseItemId String
  enhanceLevel Int @default(0)
  quality Int @default(0)
  qualityCraftCount Int @default(0)
  itemLevel Int @default(10)
  status ArmorInstanceStatus @default(OWNED)
  /** 사용자가 실수 방지용으로 잠근 장비 */
  userLocked Boolean @default(false)
  /** JSON 배열: `{ optionId, tier }[]` 제작 시 부여 옵션 */
  optionsJson String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseItem Item @relation(fields: [baseItemId], references: [id], onDelete: Restrict)

  equippedHelmetOn Minion[] @relation("MinionEquippedHelmetInst")
  equippedChestOn Minion[] @relation("MinionEquippedChestInst")
  equippedPantsOn Minion[] @relation("MinionEquippedPantsInst")
  equippedBootsOn Minion[] @relation("MinionEquippedBootsInst")
  listing Listing?

  @@index([userId, createdAt])
  @@index([baseItemId])
}

model MinionTrait {
  id       String @id @default(cuid())
  minionId String
  type     MinionTraitType
  rank     Int @default(1)
  xp       Int @default(0)

  minion Minion @relation(fields: [minionId], references: [id], onDelete: Cascade)

  @@index([minionId])
  @@unique([minionId, type])
}

model Item {
  id       String @id @default(cuid())
  name     String
  category String
  tradable Boolean @default(true)
  /** 1=일반 … 8=초월 (`itemGrade.ts`의 `ITEM_GRADE_LABELS`와 대응) */
  grade    Int     @default(1)

  stacks   InventoryStack[]
  enhancements UserItemEnhancement[]
  listings Listing[]
  weaponInstances WeaponInstance[]
  armorInstances ArmorInstance[]
  minionsEquippedHelmet Minion[] @relation("MinionEquippedHelmet")
  minionsEquippedChest  Minion[] @relation("MinionEquippedChest")
  minionsEquippedPants  Minion[] @relation("MinionEquippedPants")
  minionsEquippedBoots  Minion[] @relation("MinionEquippedBoots")
  minionsEquippedRing1     Minion[] @relation("MinionEquippedRing1")
  minionsEquippedRing2     Minion[] @relation("MinionEquippedRing2")
  minionsEquippedNecklace  Minion[] @relation("MinionEquippedNecklace")
  minionsEquippedNecklace2 Minion[] @relation("MinionEquippedNecklace2")
  minionsEquippedRelic     Minion[] @relation("MinionEquippedRelic")
  minionsEquippedRelic2    Minion[] @relation("MinionEquippedRelic2")
  minionsEquippedRelic3    Minion[] @relation("MinionEquippedRelic3")

  royalPrice        RoyalPrice?
  blackMarketPrice  BlackMarketPrice?
  blackMarketEvents BlackMarketEvent[]
  royalTrades       RoyalTradeLog[]
  blackMarketTrades BlackMarketTradeLog[]

  tradeEscrowStacks TradeEscrowStack[]
}

model InventoryStack {
  userId String
  itemId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity       Int @default(0)
  /** 사용·판매·소비에서 제외되는 잠금 수량 */
  lockedQuantity Int @default(0)

  @@id([userId, itemId])
}

enum DungeonRunStatus {
  RUNNING
  STOPPED
}

model DungeonRun {
  id       String @id @default(cuid())
  userId   String
  dungeonId String
  status   DungeonRunStatus @default(RUNNING)

  startedAt DateTime @default(now())
  lastTickAt DateTime @default(now())

  wins   Int @default(0)
  losses Int @default(0)

  /** PUSH_LUCK: 현재 진행 중인 층(1부터). AUTO_WAVES에는 표시용 */
  floor Int @default(1)
  /** PUSH_LUCK: 누적 보상(정산 전). 예: [{"itemId":"item_slime_gel","qty":3}] */
  pendingLootJson String @default("[]")
  /** PUSH_LUCK: 정산 전 누적 골드 */
  pendingGold Int @default(0)
  /** PUSH_LUCK: 파티원 층간 유지 HP. 예: [{"minionId":"…","hp":80,"maxHp":120,"label":"전사 1"}] */
  partyHpJson String @default("[]")
  /** PUSH_LUCK: 런 시작 시 고정된 파티 전투 빌드(장비·스킬·코덱스). 층마다 재조회하지 않음 */
  partyBuildJson String @default("")
  /** ATB 전투 진행 상태 (JSON) */
  combatStateJson String @default("")
  /** true면 AUTO_WAVES 틱(배속·일일 한도) — 던전 mode와 무관 */
  autoExplore Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  party DungeonPartyMember[]

  @@index([userId])
  @@index([dungeonId])
}

/** 던전 층 클리어 등으로 지갑에 들어온 골드 — 홈 골드 흐름 집계용 */
model DungeonGoldEarn {
  id        String   @id @default(cuid())
  userId    String
  dungeonId String
  floor     Int
  amount    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([dungeonId, createdAt])
}

model DungeonPartyMember {
  id        String @id @default(cuid())
  runId     String
  minionId  String

  run    DungeonRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  minion Minion     @relation(fields: [minionId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([minionId])
  @@unique([runId, minionId])
}

enum RaidRunStatus {
  RUNNING
  STOPPED
  CLEARED
  FAILED
}

enum TowerRunStatus {
  RUNNING
  STOPPED
}

model RaidRun {
  id              String        @id @default(cuid())
  userId          String
  raidId          String
  /** normal | hard — raids.json difficulty 스냅샷 */
  difficulty      String        @default("normal")
  status          RaidRunStatus @default(RUNNING)
  phase           Int           @default(1)
  wins            Int           @default(0)
  losses          Int           @default(0)
  pendingLootJson String        @default("[]")
  partyHpJson     String        @default("[]")
  /** 진행 중 ATB 전투 상태 (JSON). 비어 있으면 비전투 */
  combatStateJson String        @default("")
  startedAt       DateTime      @default(now())
  lastTickAt      DateTime      @default(now())

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  party RaidPartyMember[]

  @@index([userId, status])
  @@index([raidId])
}

model RaidPartyMember {
  id       String @id @default(cuid())
  runId    String
  minionId String

  run    RaidRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  minion Minion  @relation(fields: [minionId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([minionId])
  @@unique([runId, minionId])
}

model TowerRun {
  id              String         @id @default(cuid())
  userId          String
  status          TowerRunStatus @default(RUNNING)
  seasonKey       String         @default("default")
  floor           Int            @default(1)
  bestFloor       Int            @default(0)
  wins            Int            @default(0)
  losses          Int            @default(0)
  pendingLootJson String         @default("[]")
  partyHpJson     String         @default("[]")
  startedAt       DateTime       @default(now())
  lastTickAt      DateTime       @default(now())

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  party TowerPartyMember[]

  @@index([userId, status])
  @@index([seasonKey])
}

model PvpMatch {
  id               String   @id @default(cuid())
  attackerId       String
  defenderId       String
  attackerMinionId String
  defenderMinionId String
  /** ATTACKER_WIN | DEFENDER_WIN */
  outcome          String
  combatLogJson    String
  createdAt        DateTime @default(now())

  attacker User @relation("PvpAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defender User @relation("PvpDefender", fields: [defenderId], references: [id], onDelete: Cascade)

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
}

model TowerPartyMember {
  id       String @id @default(cuid())
  runId    String
  minionId String

  run    TowerRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  minion Minion   @relation(fields: [minionId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([minionId])
  @@unique([runId, minionId])
}

model LeaderboardEntry {
  id          String   @id @default(cuid())
  boardKey    String
  seasonKey   String   @default("default")
  userId      String
  score       Int      @default(0)
  displayName String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardKey, seasonKey, userId])
  @@index([boardKey, seasonKey, score])
}

model Listing {
  id       String         @id @default(cuid())
  saleType ListingSaleType
  status   ListingStatus  @default(ACTIVE)

  sellerId String
  seller   User   @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)

  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Int

  // Optional: 개별 무기(WeaponInstance) 거래
  weaponInstanceId String? @unique
  weaponInstance   WeaponInstance? @relation(fields: [weaponInstanceId], references: [id], onDelete: SetNull)

  // Optional: 개별 방어구(ArmorInstance) 거래
  armorInstanceId String? @unique
  armorInstance   ArmorInstance? @relation(fields: [armorInstanceId], references: [id], onDelete: SetNull)

  // FIXED
  fixedPricePerUnit Int?
  // 총액 고정가(부분 구매 불가). 값이 있으면 fixedPricePerUnit은 null로 취급
  fixedPriceTotal   Int?

  // AUCTION
  startPrice      Int?
  endsAt          DateTime?
  highestBid      Int?
  highestBidderId String?
  highestBidder   User? @relation("HighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids Bid[]
  txs  Transaction[]

  @@index([status, saleType, createdAt])
  @@index([itemId, status])
  @@index([sellerId, status])
  @@index([endsAt])
}

model Bid {
  id        String   @id @default(cuid())
  listingId String
  bidderId  String

  amount    Int
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([bidderId, createdAt])
}

model Transaction {
  id        String @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String

  itemId    String
  quantity  Int
  saleType  ListingSaleType

  grossGold Int
  feeGold   Int
  netGold   Int

  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([itemId, createdAt])
}

/** 세계/채널별 텍스트 채팅 (프로토타입: 폴링 수신) */
model ChatMessage {
  id        String   @id @default(cuid())
  channel   String   @default("world")
  userId    String
  body      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel, createdAt])
  @@index([userId, createdAt])
}
