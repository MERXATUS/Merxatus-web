{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "set NEXT_DISABLE_TURBOPACK=1&& next dev",
    "dev:cmd": "cmd /c \"set NEXT_DISABLE_TURBOPACK=1&& next dev\"",
    "bots:tick": "node --env-file=.env ./scripts/bot-tick-once.mjs",
    "bots:tick:loop": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\bot-tick-loop.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
