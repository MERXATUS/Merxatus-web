{
  "name": "merxatus",
  "version": "1.0.0",
  "private": true,
  "description": "Merxatus game — run npm scripts from repo root (delegates to web/)",
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm run start --prefix web",
    "lint": "npm run lint --prefix web",
    "apply:merxatus-csv": "npm run apply:merxatus-csv --prefix web",
    "validate:minion-csv": "npm run validate:minion-csv --prefix web"
  }
}
